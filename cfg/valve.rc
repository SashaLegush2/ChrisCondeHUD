// load the base configuration
//exec default.cfg
r_decal_cullsize 1

// Setup custom controller
exec joystick.cfg

// run a user script file if present
exec autoexec.cfg

//
// stuff command line statements
//
stuffcmds

// display the startup level
startupmenu

// FOR XBOX CERT
//sv_unlockedchapters 99

//extends the dimmer to the bottom
exec dimmer.cfg

cl_mainmenu_safemode 1

cl_crosshair_red 0
cl_crosshair_green 0
cl_crosshair_blue 0
cl_crosshairalpha 255
cl_crosshair_scale 10.8

cl_crosshaircolor 5
cl_crosshair_file ""
crosshair 1
